#!/bin/bash
# Sonph-Code - Claude Code clone launcher script
# Usage: sonph-code [directory]
#
# This script launches the coding agent from any directory.
# The working directory will be set to the current directory or specified directory.

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Determine the working directory
if [ $# -gt 0 ]; then
    # Directory specified as argument
    TARGET_DIR="$1"
    if [ ! -d "$TARGET_DIR" ]; then
        echo "Error: Directory '$TARGET_DIR' does not exist"
        exit 1
    fi
    # Convert to absolute path
    WORKING_DIR="$(cd "$TARGET_DIR" && pwd)"
else
    # Use current working directory
    WORKING_DIR="$(pwd)"
fi

echo "🚀 Starting Sonph-Code in: $WORKING_DIR"

# Change to the script directory to run with uv
cd "$SCRIPT_DIR"

# Set the initial directory environment variable
export INITIAL_DIR="$WORKING_DIR"

# Run the main script using uv to ensure proper environment
uv run python main.py